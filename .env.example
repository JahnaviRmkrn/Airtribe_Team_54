# Copy to .env.local. Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL used to build share links (optional; defaults to request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pine Labs Online (guest payments). Server only: never expose to the browser
# or commit real values. Without them the pay routes return 503.
PINE_CLIENT_ID=
PINE_CLIENT_SECRET=
# uat (default) or production
PINE_ENV=uat
