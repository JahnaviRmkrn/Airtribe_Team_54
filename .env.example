# Copy to .env.local. Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL used to build share links (optional; defaults to request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Voice onboarding + transcript extraction (all optional, all server-only) ---
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
# ElevenLabs agent for "Talk instead" (create it: python3 scripts/setup_elevenlabs_agent.py).
# Without these, GET /api/voice/signed-url returns 503 and the UI offers typing only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# POST /api/extract uses ONE LLM key (Gemini is tried first). Without either it
# falls back to the built-in rule-based parser.
GEMINI_API_KEY=
OPENAI_API_KEY=
# EXTRACT_MODEL=gemini-2.0-flash
