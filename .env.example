# Copy to .env.local. Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL used to build share links (optional; defaults to request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pine Labs Online (guest payments). Server only: never expose to the browser
# or commit real values. Without them the pay routes return 503.
PINE_CLIENT_ID=
PINE_CLIENT_SECRET=
# uat (default) or production
PINE_ENV=uat

# --- Voice onboarding + transcript extraction (all optional, all server-only) ---
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
# ElevenLabs agent for "Talk instead" (create it: python3 scripts/setup_elevenlabs_agent.py).
# Without these, GET /api/voice/signed-url returns 503 and the UI offers typing only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# POST /api/extract uses the first configured LLM key (DeepSeek, then Gemini,
# then OpenAI). With none set - or if every call fails - it falls back to the
# built-in rule-based parser.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Any other OpenAI-compatible API: OPENAI_BASE_URL=https://host/v1 with
# EXTRACT_MODEL=<model>. Server env only (it receives OPENAI_API_KEY).
# OPENAI_BASE_URL=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# EXTRACT_MODEL=gemini-2.0-flash

# Optional AgenticOrg platform extraction. Set BOTH to opt in; leave both empty
# to use the providers above. Pending approval/failure never falls through.
AGENTICORG_API_KEY=
AGENTICORG_AGENT_ID=
# AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com


# --- Social sign-in (Google / Facebook / LinkedIn / Instagram) ---
# These feed the env() substitutions in supabase/config.toml for LOCAL auth.
# Export them in your shell before `supabase start` (Next.js does not read them).
# For a hosted project, enter the same values in the Supabase dashboard under
# Authentication -> Providers. Setup guide: docs/social-auth-setup.md
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=
# Instagram has no built-in Supabase provider. It is configured as a custom
# OAuth2 provider (custom:instagram) in the dashboard - see docs/social-auth-setup.md
