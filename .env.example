# Copy to .env (git-ignored) and fill in. Everything is optional:
# without ElevenLabs the confirm screen offers the typed fallback, and
# without an LLM key /api/extract uses the built-in rule-based parser.

# ElevenLabs voice agent (create it with: python scripts/setup_elevenlabs_agent.py)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Transcript extraction - set ONE of these (Gemini is tried first)
GEMINI_API_KEY=
OPENAI_API_KEY=
# EXTRACT_MODEL=gemini-2.0-flash
